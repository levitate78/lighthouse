# ── LIGHTHOUSE — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values before running.
#
# Generate secure random keys with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# ── Flask (REQUIRED) ────────────────────────────────────────────────────────
# Secret key for session signing / cookie security.
SECRET_KEY=your-secure-secret-key-here

# Secret key used to encrypt / decrypt stored GitLab tokens (Fernet).
# Must be different from SECRET_KEY and must not change after tokens are stored.
GLT_SECRET_KEY=your-different-secure-glt-key-here

FLASK_DEBUG=false

# ── Database ────────────────────────────────────────────────────────────────
# Default: SQLite (suitable for local dev only).
# Production: use the PostgreSQL URL below (docker-compose sets this automatically).
DATABASE_URL=sqlite:///pipeline_monitor.db
# DATABASE_URL=postgresql+psycopg2://lighthouse:password@localhost/lighthouse

# ── PostgreSQL (docker-compose only) ───────────────────────────────────────
# The docker-compose.yml reads this to configure both the db service and the
# DATABASE_URL for the backend service.
POSTGRES_PASSWORD=change-me-in-production

# ── GitLab connection (REQUIRED for pipeline sync) ─────────────────────────
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your-personal-access-token-here
GITLAB_GROUP_ID=your-group-id-or-url-encoded-path-here

# How often to pull fresh data from GitLab (seconds).
SYNC_INTERVAL_SECONDS=60

# ── Vite dev server ─────────────────────────────────────────────────────────
# Set this when running `npm run dev` inside frontend/.
# Leave blank (or remove) in production.
VITE_DEV_SERVER=

# ── GitLab OAuth (optional — enables "Login with GitLab") ──────────────────
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=

# ── Login configuration ─────────────────────────────────────────────────────
ENABLE_GITLAB_LOGIN=true

# ── Security (set to true in production) ───────────────────────────────────
SESSION_COOKIE_SECURE=false

# ── Docker / networking ─────────────────────────────────────────────────────
# Port exposed by the frontend nginx container.
HTTP_PORT=80