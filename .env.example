# ── LIGHTHOUSE — Environment Variables ──────────────────────────
# Copy this file to .env and fill in your values.

# Flask (REQUIRED)
# Generate a secure SECRET_KEY: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secure-secret-key-here
FLASK_DEBUG=false

# Database (SQLite default; switch to PostgreSQL for production)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost/pipeline_monitor
DATABASE_URL=sqlite:///pipeline_monitor.db

# GitLab connection (REQUIRED for functionality)
GITLAB_URL=https://gitlab.com

# How often to pull fresh data from GitLab (seconds)
SYNC_INTERVAL_SECONDS=60

# Vite dev server — set this when running `npm run dev` inside frontend/.
# Remove or leave blank in production.
VITE_DEV_SERVER=

# GitLab OAuth (optional, for GitLab login)
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=

# Login configuration
ENABLE_GITLAB_LOGIN=true

# Security settings (set to true in production)
SESSION_COOKIE_SECURE=false